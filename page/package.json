{
  "name": "odroid-remote-page",
  "private": true,
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "npm run build:proto && vite",
    "build": "npm run build:proto && vite build",
    "preview": "vite preview",
    "build:proto": "pbjs -t static-module -w es6 --no-create --no-encode --no-verify --no-convert --no-delimited --no-typeurl --no-comments -o src/proto.js ../proto/status.proto"
  },
  "devDependencies": {
    "protobufjs-cli": "^1.1.2",
    "purgecss": "^7.0.2",
    "vite": "^7.0.4",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-singlefile": "^2.0.1"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.9.0",
    "@xterm/xterm": "^5.5.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "protobufjs": "^7.5.4",
    "uplot": "^1.6.32"
  }
}
