# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.4.0 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32c3"
CONFIG_BOOTLOADER_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_GPIO_CTRL_FUNC_IN_IRAM=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_HTTPD_MAX_URI_LEN=1024
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
# A new /ws client is sent the switch and Wi-Fi state from the post-handshake callback.
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
CONFIG_ESP_HTTPS_SERVER_ENABLE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# Wi-Fi: the PowerMate mostly sends, so keep the wide TX aggregation window and give
# RX the IDF defaults; the larger RX settings held ~18 KB of heap with no measurable
# gain in page load time.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=32
CONFIG_ESP_WIFI_TX_BA_WIN=32
CONFIG_FREERTOS_HZ=500
CONFIG_LWIP_LOCAL_HOSTNAME="odroid-pm"
CONFIG_LWIP_TCPIP_CORE_LOCKING=y
CONFIG_LWIP_TCPIP_CORE_LOCKING_INPUT=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_IPV6=n
# The web server's 10 sessions (POWERMATE_HTTP_MAX_OPEN_SOCKETS) plus its 3 internal
# sockets. A browser holds two WebSockets and opens one or two more while loading. With
# HTTPS on, 6 sessions plus the port-80 redirect server also fit.
CONFIG_LWIP_MAX_SOCKETS=13
# 8 x MSS per socket. 64 KB let one page load take nearly all free heap and made
# concurrent loads fail; 8 MSS loads the page ~5x faster and keeps >40 KB free
# under eight parallel loads with two streaming clients. 6 MSS was slower (0.16 s vs
# 0.12 s per page) and dropped more UART data at full line rate, as the UART stream
# backed up into its queue.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11520
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_WS_BUFFER_SIZE=2048
CONFIG_WS_DYNAMIC_BUFFER=y
# HTTPS (optional, Settings > Device). TLS 1.2 only: TLS 1.3 resumes with a fresh
# ECDHE (~0.5 s on the C3) where TLS 1.2 session tickets resume in ~45 ms, and the
# dynamic buffers crashed in the TLS 1.3 server. Dynamic buffers cut an idle session
# from ~30 KB to ~4 KB of heap. X.509 writing creates the self-signed certificate.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_ESP_TLS_SERVER_SESSION_TICKETS=y
CONFIG_MBEDTLS_X509_CREATE_C=y
CONFIG_MBEDTLS_X509_CRT_WRITE_C=y
CONFIG_MBEDTLS_PEM_WRITE_C=y
