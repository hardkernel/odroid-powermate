{
  "mcpServers": {
    "powermate": {
      "command": "${CLAUDE_PLUGIN_ROOT}/mcp-server/run.sh",
      "env": {
        "POWERMATE_HOST": "${POWERMATE_HOST:-}",
        "POWERMATE_USERNAME": "${POWERMATE_USERNAME:-admin}",
        "POWERMATE_PASSWORD": "${POWERMATE_PASSWORD:-password}",
        "POWERMATE_STATE_DIR": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
